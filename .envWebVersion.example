# =====================================================================
#  Michael Tourism Sales System - Web Version
#  Copy this file one level above WebVersion and name it .envWebVersion:
#
#      michaeltourism/
#        .envWebVersion
#        WebVersion/
#
#  Then fill in the real database credentials.
# =====================================================================

APP_NAME="Michael Tourism Sales"
APP_URL=https://sales.example.com
APP_TIMEZONE=Africa/Dar_es_Salaam
BASE_CURRENCY=USD

# --- Database credentials ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=michaeltourism
DB_USER=michaeltourism
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Session / application security ---
APP_KEY=replace-with-a-long-random-string
